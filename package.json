{
  "name": "arm64-formatter",
  "displayName": "ARM64 Assembly Formatter",
  "description": "Opinionated alignment formatting for ARM64 GNU assembly in VS Code.",
  "version": "0.0.1",
  "publisher": "jeffbmartinez",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffbmartinez/arm64-formatter.git"
  },
  "bugs": {
    "url": "https://github.com/jeffbmartinez/arm64-formatter/issues"
  },
  "homepage": "https://github.com/jeffbmartinez/arm64-formatter#readme",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Formatters",
    "Programming Languages"
  ],
  "keywords": [
    "arm64",
    "aarch64",
    "assembly",
    "gnu-as",
    "formatter"
  ],
  "activationEvents": [
    "onLanguage:arm64-asm"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test:unit": "npm run compile && node --test out/test/formatter.unit.test.js",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.2.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
